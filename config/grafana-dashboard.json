CPU: 100 - (avg by (instance) (rate(node_cpu_seconds_total{mode="idle"}[5m])) * 100)
RAM: (node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes) / node_memory_MemTotal_bytes * 100
Disk: 100 - ((node_filesystem_avail_bytes * 100) / node_filesystem_size_bytes)
Network: rate(node_network_receive_bytes_total[5m])
